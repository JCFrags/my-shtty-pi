{
  "name": "pi-herdr-status",
  "version": "0.1.0",
  "description": "Rich, display-only Herdr metadata for Pi panes without competing with Herdr's official Pi integration.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "herdr",
    "metadata"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "src",
    "dist/extensions",
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "smoke": "npm run build && node ./test/smoke-load.mjs",
    "validate": "npm run typecheck && npm test && npm run smoke",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
