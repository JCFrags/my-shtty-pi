{
  "name": "pi-herdr-orchestrator",
  "version": "0.1.0",
  "description": "Direct Herdr orchestration for Pi with Agent Board opener compatibility",
  "type": "module",
  "license": "MIT",
  "private": true,
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@pi-herdr-deck/tui": "npm:@earendil-works/pi-tui@0.84.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": false
    },
    "@earendil-works/pi-tui": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi-herdr-orchestrator-v2.js"
    ]
  },
  "keywords": [
    "pi-package",
    "herdr-plugin",
    "pi",
    "herdr",
    "tui"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json"
  }
}
