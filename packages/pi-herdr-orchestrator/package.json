{
  "name": "pi-herdr-orchestrator",
  "version": "0.1.0",
  "description": "Direct Herdr orchestration for Pi",
  "type": "module",
  "license": "MIT",
  "private": true,
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": false
    },
    "@earendil-works/pi-tui": {
      "optional": false
    }
  },
  "dependencies": {
    "pi-tool-controls": "file:../pi-tool-controls"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi-herdr-orchestrator.js"
    ]
  },
  "keywords": [
    "pi-package",
    "herdr-plugin",
    "pi",
    "herdr",
    "tui"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check:m10": "node checks/m10-reliability.mjs",
    "test": "node --test checks/*.test.mjs && npm run check:m10"
  },
  "files": ["dist", "herdr-plugin.toml", "README.md", "LICENSE", "package.json", "package-lock.json"]
}
