{
  "name": "pi-native-ssh",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "keywords": ["pi-package", "ssh", "openssh", "remote"],
  "piCompatibility": { "minimum": "0.84.1", "maximum": "0.84.2" },
  "description": "Explicit native SSH tools for configured OpenSSH hosts in Pi 0.84.1 and 0.84.2",
  "license": "MIT",
  "engines": { "node": ">=22.19.0" },
  "files": ["src", "tests", "acceptance", "README.md", "SECURITY.md", "PROVENANCE.md", "LICENSE", "config.example.json"],
  "peerDependencies": { "@earendil-works/pi-coding-agent": ">=0.84.1 <0.84.3" },
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": { "test": "node --test tests/*.test.mjs" }
}
