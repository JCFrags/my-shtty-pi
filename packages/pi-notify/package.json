{
  "name": "pi-notify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone durable events, timers, subscriptions, and optional Pi delivery.",
  "license": "MIT",
  "engines": { "node": ">=24.18.0 <25" },
  "keywords": ["pi-package", "pi-extension", "scheduler", "events"],
  "pi": { "extensions": ["./extensions/pi-notify.ts"] },
  "bin": { "pi-notify": "./bin/pi-notify" },
  "exports": {
    "./contracts": "./src/contracts.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server/index.ts",
    "./core": "./src/core/store.ts",
    "./pi-bus": "./src/pi/bus.ts"
  },
  "files": ["bin", "src", "extensions", "docs/pi-adapter.md", "README.md", "CONTRACT.md", "package.json", "package-lock.json"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "start": "node bin/pi-notify serve"
  },
  "dependencies": { "cron-parser": "5.6.1" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": ">=0.85.1 <0.86.0", "typebox": ">=1.3.7 <2" },
  "peerDependenciesMeta": { "@earendil-works/pi-coding-agent": { "optional": true }, "typebox": { "optional": true } },
  "devDependencies": { "@earendil-works/pi-coding-agent": "0.85.1", "@types/node": "24.12.4", "typebox": "1.3.7", "typescript": "5.9.3" }
}
