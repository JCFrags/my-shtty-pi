{
  "name": "pi-progressive-tools",
  "version": "0.1.2",
  "description": "Conservative progressive discovery and lazy activation for Pi tools.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "progressive-disclosure",
    "tool-discovery"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "tests",
    "docs",
    "examples",
    "CHANGELOG.md",
    "LICENSE",
    "MANIFEST.sha256",
    "README.md",
    "progressive-tools.config.json",
    "progressive-tools.schema.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0 <0.85.0",
    "@earendil-works/pi-tui": ">=0.83.0 <0.85.0",
    "typebox": ">=1.3.0 <2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "typebox": "1.3.11"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "syntax": "node --experimental-strip-types --check extensions/index.ts",
    "prepack": "npm run syntax && npm test"
  }
}
