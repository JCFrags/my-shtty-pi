{
  "name": "@context-kit/workplan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent branch-local Workplan ownership with immutable per-plan storage",
  "exports": {
    ".": "./index.ts",
    "./store": "./store.ts",
    "./legacy": "./legacy.ts",
    "./schema": "./schema.ts"
  },
  "files": ["*.ts", "README.md"],
  "license": "MIT",
  "keywords": ["pi-package"],
  "pi": { "extensions": ["./index.ts"] },
  "dependencies": {
    "@context-kit/protocol": "*",
    "@context-kit/state-store": "*",
    "@grounded/pi-core": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": { "node": ">=24" }
}
