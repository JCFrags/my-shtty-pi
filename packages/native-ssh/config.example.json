{
  "version": 2,
  "targets": {
    "server": {
      "destination": "server",
      "displayName": "server",
      "defaultCwd": "/tmp",
      "authorization": {
        "boundary": "openssh-and-remote-account",
        "confirmed": true,
        "statement": "OpenSSH configuration, host trust, and remote account permissions are the authority boundary."
      }
    }
  },
  "audit": {
    "enabled": false,
    "path": null,
    "maxBytes": 262144
  },
  "limits": {
    "commandTimeoutMs": 60000,
    "maxTransferBytes": 8388608
  }
}
