{
  "name": "pi-grounded-tools",
  "version": "0.1.0",
  "description": "Full-fidelity, evidence-first tools and coordination extensions for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "coding-agent",
    "grounded-tools"
  ],
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "packages",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./packages/files/index.ts",
      "./packages/process/index.ts",
      "./packages/lsp/index.ts",
      "./packages/dialog/index.ts",
      "./packages/tasks/index.ts",
      "./packages/notes/index.ts",
      "./packages/workplan/index.ts"
    ]
  },
  "dependencies": {
    "@grounded/pi-core": "0.1.0"
  },
  "bundledDependencies": [
    "@grounded/pi-core"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run pack:check",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "pack:check": "npm pack --dry-run --json > /dev/null && npm pack --workspaces --dry-run --json > /dev/null"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
