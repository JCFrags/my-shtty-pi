{
  "name": "pi-signal-board",
  "version": "0.1.0",
  "description": "Persistent updates and asynchronous decision inbox for the Pi coding agent.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "terminal",
    "tui",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "typebox": "1.3.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  }
}
