    "@earendil-works/pi-tui": ">=0.99.1 <0.100.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@earendil-works/pi-tui": "0.99.1",
    "@types/node": "22.15.30",
    "typebox": "1.3.7",
    "typescript": "5.8.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "syntax": "node --experimental-strip-types --check extensions/index.ts",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
