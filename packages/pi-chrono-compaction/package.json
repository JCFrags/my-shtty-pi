{
  "name": "pi-chrono-compact",
  "version": "2.0.9",
  "description": "Progressive chronological event compaction for long-running Pi sessions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-compaction",
    "jsonl",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./dist/src/pi-extension.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.2 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.2 <0.85.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^24.12.4",
    "node-gyp": "12.3.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  },
  "private": true,
  "scripts": {
    "catalog:sqlite:build": "node scripts/catalog-sqlite-probe.mjs --build-native",
    "catalog:sqlite:probe": "node scripts/catalog-sqlite-probe.mjs --probe",
    "catalog:sqlite:build-record": "node scripts/catalog-sqlite-probe.mjs --build-native-record",
    "catalog:sqlite:probe-record": "node scripts/catalog-sqlite-probe.mjs --probe-record",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "rm -rf dist-test && tsc -p tsconfig.test-build.json && node --test --test-concurrency=1 dist-test/test/*.test.js",
    "test:normal": "npm test && node scripts/benchmark-harness.mjs normal",
    "test:fixed-heap": "rm -rf dist-test && tsc -p tsconfig.test-build.json && node scripts/fixed-heap-suite.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.9.0"
  }
}
