{
  "name": "pi-chrono-compact",
  "version": "2.0.0",
  "description": "Progressive chronological event compaction for long-running Pi sessions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "context-compaction",
    "jsonl",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./dist/src/pi-extension.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.2 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.84.2 <0.85.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^24.12.4",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  },
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "rm -rf dist-test && tsc -p tsconfig.test-build.json && node --test dist-test/test/*.test.js"
  }
}
