{
  "name": "my-shtty-pi",
  "version": "0.1.0",
  "private": true,
  "description": "Source-only repository for small Pi extensions and local tools.",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "packageManager": "npm@10.9.2",
  "scripts": {
